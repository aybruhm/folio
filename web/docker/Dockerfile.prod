# Build stage
FROM node:22-slim AS build

WORKDIR /app

COPY web/package*.json ./
RUN npm ci --legacy-peer-deps

COPY web/ .
RUN npm run build
RUN npm prune --omit=dev --legacy-peer-deps


# Runtime stage - hardened image
FROM dhi.io/node:25-debian13-sfw-dev

WORKDIR /app

USER 65532:65532

COPY --chown=65532:65532 --from=build /app/build ./build
COPY --chown=65532:65532 --from=build /app/package*.json ./
COPY --chown=65532:65532 --from=build /app/node_modules ./node_modules

LABEL org.opencontainers.image.source=https://github.com/aybruhm/folio
LABEL org.opencontainers.image.description="Folio Web — self-hosted investment portfolio tracking frontend built with SvelteKit"
LABEL org.opencontainers.image.licenses=GPL-2.0

EXPOSE 3000

CMD ["node", "build/index.js"]
