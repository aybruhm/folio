{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": [
            "$app/types",
            "vite/client"
        ]
    },
    "include": ["vite-env.d.ts", "src/**/*.ts", "src/**/*.svelte"],
}
